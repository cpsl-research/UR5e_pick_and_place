<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="d435i_wrist_mount" params="
    parent
    tf_prefix:=''
    camera_offset_x:=0.0
    camera_offset_y:=-0.09
    camera_offset_z:=0.0
    camera_offset_roll:=0.0
    camera_offset_pitch:=${-pi/2 + 10*pi/180}
    camera_offset_yaw:=${pi/2}
    ">

    <!-- PickNik Wrist Mount Adapter -->
    <link name="${tf_prefix}wrist_mount_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <!-- STL is in mm (SolidWorks), scale to meters -->
          <mesh filename="package://ur5e_d435i_bringup/meshes/picknik_ur5_realsense_camera_adapter_rev2.STL"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="dark_grey">
          <color rgba="0.3 0.3 0.3 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://ur5e_d435i_bringup/meshes/picknik_ur5_realsense_camera_adapter_rev2.STL"
                scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                 iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
    </link>

    <joint name="${tf_prefix}tool0_to_wrist_mount" type="fixed">
      <parent link="${parent}"/>
      <child link="${tf_prefix}wrist_mount_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- D435i Camera Body -->
    <!--
      camera_link is the RealSense convention frame (at left IR imager).
      The realsense2_camera node publishes TF from camera_link to
      camera_color_optical_frame, camera_depth_optical_frame, etc.
      Our URDF connects camera_link to the robot TF tree via the wrist mount.

      The offset from wrist_mount to camera_link is an INITIAL ESTIMATE.
      Run hand-eye calibration to refine these values.
    -->
    <link name="${tf_prefix}camera_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <!-- D435i body: 90mm x 25mm x 25mm -->
          <box size="0.025 0.09 0.025"/>
        </geometry>
        <material name="intel_grey">
          <color rgba="0.72 0.72 0.74 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.09 0.025"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.072"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00003" ixy="0.0" ixz="0.0"
                 iyy="0.00003" iyz="0.0" izz="0.00003"/>
      </inertial>
    </link>

    <joint name="${tf_prefix}wrist_mount_to_camera" type="fixed">
      <parent link="${tf_prefix}wrist_mount_link"/>
      <child link="${tf_prefix}camera_link"/>
      <!-- Initial estimate. Update with hand-eye calibration results. -->
      <origin xyz="${camera_offset_x} ${camera_offset_y} ${camera_offset_z}"
              rpy="${camera_offset_roll} ${camera_offset_pitch} ${camera_offset_yaw}"/>
    </joint>

    <!-- Mechanical reference frame at camera bottom screw -->
    <link name="${tf_prefix}camera_bottom_screw_frame"/>
    <joint name="${tf_prefix}camera_link_to_bottom_screw" type="fixed">
      <parent link="${tf_prefix}camera_link"/>
      <child link="${tf_prefix}camera_bottom_screw_frame"/>
      <origin xyz="0 0.0175 0.0125" rpy="0 0 0"/>
    </joint>

  </xacro:macro>
</robot>
